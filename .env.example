APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Critical review alerts (Phase 16) — comma-separated; uses Laravel Mail (MAIL_* above).
# Sends synchronously on ReviewCompleted (no queue:work required).
CRITICAL_ALERT_EMAILS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Required: must match the secret configured on the GitHub App webhook
GITHUB_WEBHOOK_SECRET=

# Optional API/web hosts (defaults work for github.com; override for GitHub Enterprise)
GITHUB_API_BASE=https://api.github.com
GITHUB_WEB_BASE=https://github.com

# Optional: PAT fallback when GitHub App env vars are unset
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# Must match Check Run name used by the worker/dashboard (WF-004 required status check)
GITHUB_CHECK_RUN_NAME="Automated Code Review"
# Comma-separated branches to protect on activate / Protect branches action
GITHUB_PROTECTED_BRANCHES=main,master,staging

# Required: must match worker-engine/.env (generate with: php -r "echo bin2hex(random_bytes(32));")
WORKER_API_TOKEN=

# OPS-001 worker liveness monitoring.
# Comma-separated WORKER_ID values expected to be enrolled and polling. Listed
# workers show as "Expected (Never Connected)" on /admin/health and are eligible
# for offline alerts. Leave empty to only monitor workers that have connected.
EXPECTED_WORKER_IDS=
# Comma-separated GitHub logins / author names allowed to run repo tests (WF-007).
# Prefer per-repository Trusted authors in Admin → Repositories. This env list is an optional org-wide fallback.
TRUSTED_REVIEW_AUTHORS=
# Authorize Review Now / baseline jobs for test execution (default true).
AUTHORIZE_PM_TRIGGERED_JOBS=true
EXECUTION_AUTHORIZED_TRIGGERS=manual_review_now,baseline_activation
# Changed-line coverage below this percentage blocks merging (TST-004).
CHANGED_COVERAGE_MIN_PERCENT=70
# Max age (hours) of a verified backup required before destructive migration override (CHG-002).
DESTRUCTIVE_CHANGE_BACKUP_MAX_AGE_HOURS=24
# Minutes without a heartbeat before a worker is declared offline.
WORKER_OFFLINE_AFTER_MINUTES=15
# Minutes a review job may stay in processing before jobs:sweep-stuck times it out.
REVIEW_JOB_STUCK_AFTER_MINUTES=30

# Trello (optional). API host override for mocks / enterprise proxies.
TRELLO_API_BASE=https://api.trello.com/1
TRELLO_KEY=
TRELLO_TOKEN=

# Objective/SRS Google Drive source (SRS-001). Optional: the Drive option only
# appears in the UI once both values are set. The service-account JSON may be
# inlined or given as an absolute path to the key file, and reads are restricted
# to the single folder below (SEC-005).
GOOGLE_DRIVE_API_BASE=https://www.googleapis.com/drive/v3
GOOGLE_DRIVE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
GOOGLE_DRIVE_WEB_BASE=https://drive.google.com
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
# Only needed for Workspace domain-wide delegation.
GOOGLE_DRIVE_IMPERSONATE_EMAIL=
