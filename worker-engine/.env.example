WORKER_API_URL=https://staging.codereviewapp.online/api/v1/worker
WORKER_API_TOKEN=your_worker_api_token_here
WORKER_ID=mac-mini-primary

# Preferred: GitHub App credentials so the worker can mint installation tokens
# and auto-refresh them before each clone (~1 hour expiry, no manual restart).
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Inline PEM with \n newlines, or absolute path to a .pem file.
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_BASE=https://api.github.com
GITHUB_WEB_BASE=https://github.com

# Optional PAT fallback when App credentials are unset.
GITHUB_TOKEN=

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=codellama:7b

# Objective compliance budgets (prevent 30m stuck-job timeouts on large SRS checklists)
OBJECTIVE_BATCH_SIZE=20
OBJECTIVE_CALL_TIMEOUT_SECONDS=30
OBJECTIVE_MAX_CALLS=3
OBJECTIVE_WALL_CLOCK_SECONDS=120

POLL_INTERVAL_SECONDS=5
WORK_DIR=./workspace
